name: Keepalive Workflow

on:
  schedule:
    # 매주 일요일 0시에 자동으로 실행
    - cron: '0 0 * * 0'
  workflow_dispatch: # 수동 실행 옵션

jobs:
  cronjob-based-workflow-keepalive:
    runs-on: ubuntu-latest
    permissions:
      actions: write
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: gautamkrishnar/keepalive-workflow@v2 # 60일 비활성화를 방지해주는 액션
